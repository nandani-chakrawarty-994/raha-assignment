# MongoDB connection string (Atlas free tier works)
# Prefer the standard mongodb:// URI on Windows if mongodb+srv fails with querySrv ECONNREFUSED
# Include the database name before ? — e.g. ...mongodb.net/raha-field-tracker?...
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/raha-field-tracker?retryWrites=true&w=majority

# JWT secret — use a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional: OpenRouteService API key for road distance
# Get a free key at https://openrouteservice.org/dev/#/signup
# If unset, the app falls back to Haversine (straight-line) distance
OPENROUTESERVICE_API_KEY=

# App URL (used in seed / docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
